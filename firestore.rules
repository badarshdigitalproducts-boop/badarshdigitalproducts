rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (request.auth.token.admin == true || request.auth.uid == 'badarsh-admin');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Public Storefront Catalog: Anyone can read, but ONLY authenticated Admins can write
    match /products/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /services/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blog_posts/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{document} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /settings/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: Stop IDOR enumeration.
    // Customers can only read their OWN order. Public cannot enumerate or list all orders.
    match /orders/{document} {
      allow read: if isAdmin() || (isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.customerEmail == request.auth.token.email
      ));
      allow create: if isAuthenticated() || (request.resource.data.totalAmount is number && request.resource.data.customerEmail is string);
      allow update, delete: if isAdmin();
    }

    // Users: Strict ownership verification (auth.uid === userId)
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Inbound Leads: Public can only CREATE a lead; competitors CANNOT read or scrape
    match /leads/{document} {
      allow read: if isAdmin();
      allow create: if request.resource.data.email is string;
      allow update, delete: if isAdmin();
    }

    // Newsletter Subscribers: Public can only CREATE; cannot read or scrape audience
    match /subscribers/{document} {
      allow read: if isAdmin();
      allow create: if request.resource.data.email is string;
      allow update, delete: if isAdmin();
    }

    // Audit Logs: Immutable log records. Admin-only read, authenticated write
    match /audit_logs/{document} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
