{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "badarshdigitalproducts",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://badarsh.com",
    "ADMIN_SECRET_KEY": "badarsh@founder2026",
    "ADMIN_SESSION_SECRET": "badarsh_secure_hmac_session_secret_994821a8b3c4",
    "CASHFREE_ENV": "production"
  }
}
