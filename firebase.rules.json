{
  "rules": {
    "products": {
      ".read": true,
      "$productId": {
        ".write": "auth != null && (auth.token.admin === true || auth.uid === 'badarsh-admin')",
        ".validate": "newData.hasChildren(['id', 'title', 'price']) && newData.child('price').isNumber()"
      }
    },
    "services": {
      ".read": true,
      "$serviceId": {
        ".write": "auth != null && (auth.token.admin === true || auth.uid === 'badarsh-admin')",
        ".validate": "newData.hasChildren(['id', 'title'])"
      }
    },
    "blog_posts": {
      ".read": true,
      "$slug": {
        ".write": "auth != null && (auth.token.admin === true || auth.uid === 'badarsh-admin')",
        ".validate": "newData.hasChildren(['slug', 'title'])"
      }
    },
    "coupons": {
      ".read": "auth != null",
      "$couponId": {
        ".write": "auth != null && (auth.token.admin === true || auth.uid === 'badarsh-admin')",
        ".validate": "newData.hasChildren(['code', 'discountValue'])"
      }
    },
    "settings": {
      ".read": true,
      ".write": "auth != null && (auth.token.admin === true || auth.uid === 'badarsh-admin')",
      ".validate": "newData.hasChildren(['siteName'])"
    },
    "orders": {
      ".read": false,
      "$orderId": {
        ".read": "auth != null && (auth.token.admin === true || data.child('userId').val() === auth.uid || data.child('customerEmail').val() === auth.token.email)",
        ".write": "auth != null && (auth.token.admin === true || auth.uid === 'badarsh-admin')",
        ".validate": "newData.hasChildren(['id', 'customerName', 'totalAmount']) && newData.child('totalAmount').isNumber()"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        ".write": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        ".validate": "newData.hasChildren(['email'])"
      }
    },
    "leads": {
      ".read": "auth != null && auth.token.admin === true",
      "$leadId": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['id', 'name', 'email'])"
      }
    },
    "subscribers": {
      ".read": "auth != null && auth.token.admin === true",
      "$subscriberId": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['email'])"
      }
    },
    "audit_logs": {
      ".read": "auth != null && auth.token.admin === true",
      "$logId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['id', 'action', 'timestamp'])"
      }
    }
  }
}
